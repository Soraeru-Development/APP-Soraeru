<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Soraeru.Pages.SettingsPage"
             Title="設定"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{StaticResource SurfaceBright}">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,32" Spacing="10" MaximumWidthRequest="480" HorizontalOptions="Center">

            <Label x:Name="StatusLabel"
                   Text="載入中…"
                   Style="{StaticResource CaptionLabel}"
                   IsVisible="False" />

            <Label Text="帳號" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="DisplayNameLabel" Text="名稱：—" Style="{StaticResource BodyLabel}" FontSize="15" />
                    <Label x:Name="EmailLabel" Text="Email：—" Style="{StaticResource BodyLabel}" FontSize="15" />
                    <Label x:Name="LoginProviderLabel" Text="登入方式：—" Style="{StaticResource BodyLabel}" FontSize="15" />
                </VerticalStackLayout>
            </Border>

            <Label Text="使用額度" Style="{StaticResource SectionTitle}" Margin="0,16,0,4" />
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="QuotaLabel"
                           Text="今日剩餘：—"
                           TextColor="{StaticResource OnSurface}"
                           FontSize="16"
                           FontAttributes="Bold" />
                    <Label x:Name="PlanLabel" Text="方案：—" Style="{StaticResource BodyLabel}" FontSize="15" />
                    <Label Text="付費方案即將推出"
                           Style="{StaticResource CaptionLabel}"
                           TextColor="{StaticResource Outline}"
                           Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>

            <Label Text="標記偏好預設" Style="{StaticResource SectionTitle}" Margin="0,16,0,4" />
            <HorizontalStackLayout Spacing="16">
                <RadioButton Content="注音" IsChecked="True" GroupName="DefaultNotation" />
                <RadioButton Content="羅馬" GroupName="DefaultNotation" />
                <RadioButton Content="混合" GroupName="DefaultNotation" />
            </HorizontalStackLayout>

            <Label Text="關於" Style="{StaticResource SectionTitle}" Margin="0,16,0,4" />
            <Border Style="{StaticResource CardBorder}" Padding="8,4">
                <VerticalStackLayout Spacing="0">
                    <Button Text="再次查看使用說明"
                            Style="{StaticResource LinkButton}"
                            HorizontalOptions="Start"
                            Clicked="OnOnboardingClicked" />
                    <Button Text="隱私權政策"
                            Style="{StaticResource LinkButton}"
                            HorizontalOptions="Start"
                            Clicked="OnPrivacyClicked" />
                    <Label Text="版本 1.0.0"
                           Style="{StaticResource CaptionLabel}"
                           Margin="12,8,12,12" />
                </VerticalStackLayout>
            </Border>

            <Button Text="登出"
                    Style="{StaticResource SecondaryButton}"
                    Clicked="OnLogoutClicked"
                    Margin="0,16,0,0" />
            <Button Text="刪除帳號"
                    Style="{StaticResource DangerButton}"
                    Clicked="OnDeleteAccountClicked"
                    Margin="0,8,0,0" />
            <Label Text="提示：本機仍保有有效登入時，啟動會略過登入頁，直接進入首頁或首次說明。"
                   Style="{StaticResource CaptionLabel}"
                   Margin="4,8,4,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
