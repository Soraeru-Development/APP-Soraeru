<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Soraeru.Pages.AnalysisResultPage"
             Title="分析結果"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{StaticResource SurfaceBright}">

    <Grid RowDefinitions="*,Auto"
          MaximumWidthRequest="600"
          HorizontalOptions="Center">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,24,16,16" Spacing="24">

                <!-- Hero vocab card (L10) -->
                <Border x:Name="WordCardBorder"
                        Stroke="{StaticResource OutlineVariant}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{StaticResource SurfaceContainer}"
                        Padding="16">
                    <VerticalStackLayout Spacing="0">
                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 999"
                                BackgroundColor="{StaticResource SurfaceContainerHighest}"
                                Padding="12,6"
                                HorizontalOptions="Start">
                            <HorizontalStackLayout Spacing="8">
                                <Image Source="ic_language.png"
                                       WidthRequest="16"
                                       HeightRequest="16"
                                       Aspect="AspectFit"
                                       VerticalOptions="Center" />
                                <Label x:Name="LanguagePillLabel"
                                       Text=""
                                       TextColor="{StaticResource OnSurfaceVariant}"
                                       FontSize="14"
                                       VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Label x:Name="SourceTextLabel"
                               Text=""
                               FontSize="40"
                               FontAttributes="Bold"
                               TextColor="{StaticResource OnSurface}"
                               LineBreakMode="WordWrap"
                               Margin="0,16,0,0" />
                        <Label x:Name="MeaningLabel"
                               Text=""
                               FontSize="22"
                               TextColor="{StaticResource OnSurfaceVariant}"
                               LineBreakMode="WordWrap"
                               Margin="0,4,0,0" />

                        <BoxView HeightRequest="1"
                                 Color="{StaticResource OutlineVariant}"
                                 Opacity="0.3"
                                 Margin="0,16,0,12" />

                        <HorizontalStackLayout Spacing="8" Margin="0,0,0,12">
                            <Image Source="ic_record_voice_over.png"
                                   WidthRequest="20"
                                   HeightRequest="20"
                                   Aspect="AspectFit"
                                   VerticalOptions="Center" />
                            <Label x:Name="ReadingLabel"
                                   Text=""
                                   FontSize="16"
                                   TextColor="{StaticResource OnSurface}"
                                   LineBreakMode="WordWrap"
                                   VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>

                        <Button Text="播放正式發音"
                                ImageSource="ic_play_circle.png"
                                ContentLayout="Left,8"
                                BackgroundColor="{StaticResource SecondaryContainer}"
                                TextColor="{StaticResource OnSecondaryContainer}"
                                BorderWidth="0"
                                CornerRadius="8"
                                FontSize="14"
                                HeightRequest="40"
                                Padding="16,0"
                                HorizontalOptions="Start"
                                MinimumHeightRequest="40"
                                Clicked="OnPlayClicked" />
                    </VerticalStackLayout>
                </Border>

                <!-- MVP provenance badges (not in Stitch HTML) -->
                <Border x:Name="DraftBadgeBanner" Style="{StaticResource WarningBanner}" IsVisible="False">
                    <Label x:Name="DraftBadgeLabel"
                           Text="AI 草稿／未經聽感核定"
                           TextColor="{StaticResource StatusWarning}"
                           FontAttributes="Bold"
                           FontSize="14" />
                </Border>

                <Border x:Name="VerifiedBadgeBanner" Style="{StaticResource InfoBanner}" IsVisible="False">
                    <Label x:Name="VerifiedBadgeLabel"
                           Text="聽感已核定／策展"
                           TextColor="{StaticResource StatusInfo}"
                           FontAttributes="Bold"
                           FontSize="14" />
                </Border>

                <!-- Warning / disclaimer -->
                <Border StrokeThickness="0"
                        BackgroundColor="#FFF8E1"
                        StrokeShape="RoundRectangle 0,8,0,8"
                        Padding="0">
                    <Grid ColumnDefinitions="4,*" ColumnSpacing="0">
                        <BoxView Grid.Column="0" Color="{StaticResource StatusWarning}" />
                        <HorizontalStackLayout Grid.Column="1" Padding="12,14" Spacing="12">
                            <Image Source="ic_warning.png"
                                   WidthRequest="22"
                                   HeightRequest="22"
                                   Aspect="AspectFit"
                                   VerticalOptions="Start"
                                   Margin="0,2,0,0" />
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Fill">
                                <Label Text="注意：記憶輔助音"
                                       TextColor="{StaticResource StatusWarning}"
                                       FontAttributes="Bold"
                                       FontSize="18" />
                                <Label x:Name="NoticeLabel"
                                       Text="以下近似音僅供記憶，請以正式發音為準。"
                                       TextColor="#5c3a21"
                                       FontSize="16"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- Mnemonic candidates -->
                <VerticalStackLayout Spacing="16">
                    <Label Text="選擇最佳記憶聯想"
                           TextColor="{StaticResource OnSurface}"
                           FontSize="18"
                           FontAttributes="Bold"
                           Margin="0,0,0,0" />
                    <BoxView HeightRequest="1"
                             Color="{StaticResource OutlineVariant}"
                             Opacity="0.3"
                             Margin="0,-8,0,0" />
                    <VerticalStackLayout x:Name="MnemonicsHost" Spacing="12" />
                </VerticalStackLayout>

                <Label x:Name="QuotaLabel"
                       Style="{StaticResource CaptionLabel}" />

                <Button Text="語言不對？返回修改"
                        Style="{StaticResource LinkButton}"
                        HorizontalOptions="Start"
                        Clicked="OnFixLanguageClicked" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Sticky CTA: regenerate + save -->
        <Grid Grid.Row="1"
              RowDefinitions="1,Auto"
              BackgroundColor="{StaticResource SurfaceBright}">
            <BoxView Grid.Row="0"
                     Color="{StaticResource OutlineVariant}"
                     Opacity="0.2"
                     HeightRequest="1"
                     VerticalOptions="Start" />
            <Grid Grid.Row="1"
                  ColumnDefinitions="*,2*"
                  ColumnSpacing="16"
                  Padding="16,12,16,20">
                <Button x:Name="RegenerateButton"
                        Grid.Column="0"
                        Text="重新產生"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource OnSurface}"
                        BorderColor="{StaticResource Outline}"
                        BorderWidth="1"
                        CornerRadius="999"
                        FontSize="14"
                        HeightRequest="48"
                        MinimumHeightRequest="48"
                        Clicked="OnRegenerateClicked" />
                <Button Grid.Column="1"
                        Text="儲存單字卡"
                        ImageSource="ic_save_on_primary.png"
                        ContentLayout="Left,8"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource OnPrimary}"
                        CornerRadius="999"
                        FontSize="18"
                        FontAttributes="Bold"
                        HeightRequest="48"
                        MinimumHeightRequest="48"
                        Clicked="OnSaveClicked" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
