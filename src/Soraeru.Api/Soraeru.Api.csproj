<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Soraeru.Application\Soraeru.Application.csproj" />
    <ProjectReference Include="..\Soraeru.Infrastructure\Soraeru.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>a305df7e-5da5-4a0d-be8c-ddd04389f8dd</UserSecretsId>
    <!-- VS / `dotnet run` 預設用 http（5080），與 App / README 一致；勿用會開 7080 的 https -->
    <LaunchProfile>http</LaunchProfile>
    <ActiveDebugProfile>http</ActiveDebugProfile>
  </PropertyGroup>

</Project>
