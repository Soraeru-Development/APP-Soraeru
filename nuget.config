<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Do not set globalPackagesFolder here: Linux Docker has no D:\ and restore would fail.
    Windows short path is forced by Directory.Build.props (RestorePackagesPath).
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
