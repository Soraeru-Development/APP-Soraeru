<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Soraeru.Pages.OcrSelectPage"
             Title="選擇單字"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{StaticResource SurfaceBright}">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20,16" Spacing="14" MaximumWidthRequest="480" HorizontalOptions="Center">

                <Grid ColumnDefinitions="72,*" ColumnSpacing="12">
                    <Border StrokeThickness="0"
                            BackgroundColor="{StaticResource SurfaceDim}"
                            StrokeShape="RoundRectangle 8"
                            HeightRequest="72" WidthRequest="72">
                        <Image x:Name="ThumbImage"
                               Aspect="AspectFill" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                        <Label x:Name="ImageCaptionLabel"
                               Text="已選圖片"
                               Style="{StaticResource SectionTitle}"
                               FontSize="16" />
                        <Button Text="返回重選圖"
                                Style="{StaticResource LinkButton}"
                                Padding="0"
                                HorizontalOptions="Start"
                                Clicked="OnReselectClicked" />
                    </VerticalStackLayout>
                </Grid>

                <Label Text="辨識文字（可編輯）" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                <Border Style="{StaticResource InputBorder}" Padding="12,8">
                    <Editor x:Name="OcrEditor"
                            AutoSize="TextChanges"
                            HeightRequest="80"
                            TextChanged="OnOcrTextChanged" />
                </Border>

                <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                    <Label Text="候選單字"
                           Style="{StaticResource FieldLabel}"
                           Margin="0"
                           VerticalOptions="End" />
                    <Label x:Name="SelectionCountLabel"
                           Grid.Column="1"
                           Text="已選擇 0 個單字"
                           Style="{StaticResource CaptionLabel}"
                           VerticalOptions="End" />
                </Grid>
                <Border Style="{StaticResource CardBorder}" Padding="8,4">
                    <VerticalStackLayout x:Name="TokenList" Spacing="0" />
                </Border>

                <Label Text="來源語言"
                       Style="{StaticResource FieldLabel}"
                       Margin="0,8,0,0" />
                <Border Stroke="{StaticResource OutlineVariant}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="{StaticResource Surface}"
                        Padding="12,4">
                    <Picker x:Name="LanguagePicker"
                            Title="選擇語言"
                            SelectedIndex="0"
                            TextColor="{StaticResource OnSurface}"
                            TitleColor="{StaticResource Outline}"
                            FontSize="16"
                            SelectedIndexChanged="OnLanguagePickerChanged">
                        <Picker.Items>
                            <x:String>自動偵測</x:String>
                            <x:String>日文 (Japanese)</x:String>
                            <x:String>泰文 (Thai)</x:String>
                            <x:String>他加祿語 (Tagalog)</x:String>
                            <x:String>韓文 (Korean)</x:String>
                            <x:String>越南文 (Vietnamese)</x:String>
                        </Picker.Items>
                    </Picker>
                </Border>
                <Label x:Name="LanguageHelperLabel"
                       Text="無法從文字可靠推斷時維持自動偵測。選定具體語言後，若本機已有同字卡會直接開詳情（不消耗分析額度）。"
                       Style="{StaticResource CaptionLabel}"
                       LineBreakMode="WordWrap" />

                <Border Stroke="{StaticResource OutlineVariant}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{StaticResource SurfaceBright}"
                        Padding="16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnManualClicked" />
                    </Border.GestureRecognizers>
                    <Label Text="＋ 手動輸入其他單字"
                           TextColor="{StaticResource Primary}"
                           FontSize="14"
                           HorizontalTextAlignment="Center" />
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1"
              Style="{StaticResource StickyBar}"
              BackgroundColor="{StaticResource SurfaceBright}">
            <Button Text="分析選定單字 →"
                    Style="{StaticResource PrimaryButton}"
                    CornerRadius="28"
                    Clicked="OnAnalyzeClicked" />
        </Grid>
    </Grid>
</ContentPage>
