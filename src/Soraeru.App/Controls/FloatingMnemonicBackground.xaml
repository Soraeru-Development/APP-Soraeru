<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Soraeru.Controls.FloatingMnemonicBackground"
             InputTransparent="True"
             CascadeInputTransparent="True">

    <Grid InputTransparent="True">
        <!-- Soft atmospheric washes: light tints only (PrimaryContainer is too dark → solid black/gray blocks on Android). -->
        <Ellipse Fill="{StaticResource PrimaryFixed}"
                 Opacity="0.45"
                 HorizontalOptions="Center"
                 VerticalOptions="Start"
                 WidthRequest="520"
                 HeightRequest="420"
                 Margin="0,-80,-40,0"
                 InputTransparent="True" />
        <Ellipse Fill="{StaticResource SecondaryContainer}"
                 Opacity="0.55"
                 HorizontalOptions="Start"
                 VerticalOptions="End"
                 WidthRequest="360"
                 HeightRequest="320"
                 Margin="-100,0,0,-60"
                 InputTransparent="True" />

        <!-- Spawned fly-across word pairs (Stitch L00 animation-layer) -->
        <AbsoluteLayout x:Name="FloatingLayer"
                        InputTransparent="True" />
    </Grid>
</ContentView>
