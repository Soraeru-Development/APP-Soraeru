<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Soraeru.Pages.WordInputPage"
             Title="輸入單字"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{StaticResource SurfaceBright}">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,16,16,24"
                                 Spacing="24"
                                 MaximumWidthRequest="480"
                                 HorizontalOptions="Center">

                <!-- 外語單字或短語 -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="外語單字或短語"
                           TextColor="{StaticResource OnSurface}"
                           FontSize="18"
                           FontAttributes="Bold" />

                    <Border Stroke="{StaticResource OutlineVariant}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="{StaticResource Surface}"
                            Padding="16">
                        <Grid>
                            <Editor x:Name="WordEditor"
                                    Placeholder="例如：ขอบคุณ / salamat / ありがとう"
                                    PlaceholderColor="{StaticResource Outline}"
                                    TextColor="{StaticResource OnSurface}"
                                    FontSize="16"
                                    AutoSize="Disabled"
                                    HeightRequest="112"
                                    Margin="0,0,0,20"
                                    TextChanged="OnWordTextChanged" />
                            <Label x:Name="CharCountLabel"
                                   Text="0 / 50"
                                   TextColor="{StaticResource Outline}"
                                   FontSize="12"
                                   HorizontalOptions="End"
                                   VerticalOptions="End"
                                   Margin="0,0,0,0" />
                        </Grid>
                    </Border>

                    <Label Text="請輸入您想學習的外語單字，我們將為您生成好記的諧音與解釋。"
                           Style="{StaticResource CaptionLabel}"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <!-- 來源語言（可搜尋） -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="來源語言"
                           TextColor="{StaticResource OnSurface}"
                           FontSize="18"
                           FontAttributes="Bold" />
                    <Label x:Name="SelectedLanguageLabel"
                           Text="目前：自動偵測"
                           Style="{StaticResource CaptionLabel}" />
                    <Border Stroke="{StaticResource OutlineVariant}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="{StaticResource Surface}"
                            Padding="4,0">
                        <SearchBar x:Name="LanguageSearchBar"
                                   Placeholder="搜尋語言（如 阿拉伯 / fr / हिंदी）"
                                   PlaceholderColor="{StaticResource Outline}"
                                   TextColor="{StaticResource OnSurface}"
                                   CancelButtonColor="{StaticResource Outline}" />
                    </Border>
                    <Border Stroke="{StaticResource OutlineVariant}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="{StaticResource Surface}"
                            Padding="0"
                            HeightRequest="220">
                        <CollectionView x:Name="LanguageList"
                                        SelectionMode="Single">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="16,12">
                                        <Label Text="{Binding Display}"
                                               TextColor="{StaticResource OnSurface}"
                                               FontSize="15"
                                               LineBreakMode="TailTruncation" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                </VerticalStackLayout>

                <!-- 標記偏好：豎向選項列表 -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="標記偏好"
                           TextColor="{StaticResource OnSurface}"
                           FontSize="18"
                           FontAttributes="Bold" />

                    <Border Stroke="{StaticResource OutlineVariant}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="{StaticResource Surface}"
                            Padding="0">
                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="16"
                                  Padding="16"
                                  MinimumHeightRequest="64">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnBopomofoRowTapped" />
                                </Grid.GestureRecognizers>
                                <RadioButton x:Name="NotationBopomofo"
                                             GroupName="Notation"
                                             IsChecked="True"
                                             VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="注音符號"
                                           TextColor="{StaticResource OnSurface}"
                                           FontSize="16" />
                                    <Label Text="適合熟悉台灣注音拼寫的學習者"
                                           Style="{StaticResource CaptionLabel}"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1"
                                     Color="{StaticResource OutlineVariant}"
                                     Margin="0" />

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="16"
                                  Padding="16"
                                  MinimumHeightRequest="64">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRomanRowTapped" />
                                </Grid.GestureRecognizers>
                                <RadioButton x:Name="NotationRoman"
                                             GroupName="Notation"
                                             VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="羅馬拼音"
                                           TextColor="{StaticResource OnSurface}"
                                           FontSize="16" />
                                    <Label Text="使用英文字母標示發音"
                                           Style="{StaticResource CaptionLabel}"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1"
                                     Color="{StaticResource OutlineVariant}"
                                     Margin="0" />

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="16"
                                  Padding="16"
                                  MinimumHeightRequest="64">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnMixedRowTapped" />
                                </Grid.GestureRecognizers>
                                <RadioButton x:Name="NotationMixed"
                                             GroupName="Notation"
                                             VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="混合模式"
                                           TextColor="{StaticResource OnSurface}"
                                           FontSize="16" />
                                    <Label Text="同時顯示兩種標音方式，提供更準確的參考"
                                           Style="{StaticResource CaptionLabel}"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- AI 免責資訊框 -->
                <Border StrokeThickness="0"
                        BackgroundColor="{StaticResource SurfaceContainerLow}"
                        StrokeShape="RoundRectangle 0,8,0,8"
                        Padding="0"
                        Margin="0,4,0,0">
                    <Grid ColumnDefinitions="4,*">
                        <BoxView Grid.Column="0"
                                 Color="{StaticResource StatusInfo}" />
                        <Grid Grid.Column="1"
                              ColumnDefinitions="Auto,*"
                              ColumnSpacing="12"
                              Padding="12,14">
                            <Image Grid.Column="0"
                                   Source="ic_info.png"
                                   HeightRequest="20"
                                   WidthRequest="20"
                                   Aspect="AspectFit"
                                   VerticalOptions="Start"
                                   Margin="0,1,0,0" />
                            <Label Grid.Column="1"
                                   Text="分析結果由 AI 模型生成，可能會因語言特性產生些許誤差。建議搭配原生語音朗讀功能輔助學習。"
                                   TextColor="{StaticResource OnSurfaceVariant}"
                                   FontSize="12"
                                   LineBreakMode="WordWrap" />
                        </Grid>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1"
              Style="{StaticResource StickyBar}"
              BackgroundColor="{StaticResource SurfaceBright}">
            <Button Text="✨ 開始分析"
                    Style="{StaticResource PrimaryButton}"
                    CornerRadius="28"
                    Clicked="OnAnalyzeClicked" />
        </Grid>
    </Grid>
</ContentPage>
