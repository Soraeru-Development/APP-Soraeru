<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Soraeru.Pages.ForgotPasswordPage"
             Title="重設密碼"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{StaticResource SurfaceBright}">

    <VerticalStackLayout Padding="24,24,24,32" Spacing="16" MaximumWidthRequest="480" HorizontalOptions="Center">

        <Label Text="輸入註冊電子郵件，我們會寄送重設連結。"
               Style="{StaticResource BodyLabel}" />

        <Label Text="電子郵件 Email" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
        <Border Style="{StaticResource InputBorder}">
            <Entry x:Name="EmailEntry"
                   Placeholder="you@example.com"
                   Keyboard="Email"
                   PlaceholderColor="{StaticResource Outline}" />
        </Border>

        <Button Text="寄送重設郵件"
                Style="{StaticResource PrimaryButton}"
                CornerRadius="28"
                Clicked="OnSendClicked"
                Margin="0,8,0,0" />

        <Button Text="返回登入"
                Style="{StaticResource LinkButton}"
                Clicked="OnBackLoginClicked"
                HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>
