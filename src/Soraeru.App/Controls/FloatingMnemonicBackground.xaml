<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Soraeru.Controls.FloatingMnemonicBackground"
             InputTransparent="True"
             CascadeInputTransparent="True">

    <Grid InputTransparent="True">
        <!-- Soft atmospheric washes (Stitch L00 radial feel) -->
        <BoxView Color="{StaticResource PrimaryContainer}"
                 Opacity="0.18"
                 HorizontalOptions="Center"
                 VerticalOptions="Start"
                 WidthRequest="520"
                 HeightRequest="420"
                 Margin="0,-40,0,0"
                 InputTransparent="True" />
        <BoxView Color="{StaticResource SecondaryContainer}"
                 Opacity="0.22"
                 HorizontalOptions="Start"
                 VerticalOptions="End"
                 WidthRequest="320"
                 HeightRequest="280"
                 Margin="-80,0,0,-20"
                 InputTransparent="True" />

        <!-- Spawned fly-across word pairs (Stitch L00 animation-layer) -->
        <AbsoluteLayout x:Name="FloatingLayer"
                        InputTransparent="True" />
    </Grid>
</ContentView>
