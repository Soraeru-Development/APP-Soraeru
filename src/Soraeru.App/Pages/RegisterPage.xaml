<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Soraeru.Pages.RegisterPage"
             Title="建立帳號"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{StaticResource SurfaceBright}">

    <ScrollView>
        <VerticalStackLayout Padding="24,16,24,32" Spacing="14" MaximumWidthRequest="480" HorizontalOptions="Center">

            <Label Text="顯示名稱 (選填)" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputBorder}">
                <Entry x:Name="DisplayNameEntry"
                       Placeholder="怎麼稱呼你"
                       TextColor="{StaticResource OnSurface}"
                       PlaceholderColor="{StaticResource Outline}"
                       BackgroundColor="Transparent" />
            </Border>

            <Label Text="電子郵件" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputBorder}">
                <Entry x:Name="EmailEntry"
                       Placeholder="you@example.com"
                       Keyboard="Email"
                       TextColor="{StaticResource OnSurface}"
                       PlaceholderColor="{StaticResource Outline}"
                       BackgroundColor="Transparent" />
            </Border>

            <Label Text="密碼" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputBorder}">
                <Entry x:Name="PasswordEntry"
                       IsPassword="True"
                       Placeholder="請輸入密碼"
                       TextColor="{StaticResource OnSurface}"
                       PlaceholderColor="{StaticResource Outline}"
                       BackgroundColor="Transparent" />
            </Border>
            <Label Text="請輸入至少 8 個字元的密碼。"
                   Style="{StaticResource CaptionLabel}"
                   Margin="0,-6,0,0" />

            <Label Text="確認密碼" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputBorder}">
                <Entry x:Name="ConfirmPasswordEntry"
                       IsPassword="True"
                       Placeholder="再次輸入密碼"
                       TextColor="{StaticResource OnSurface}"
                       PlaceholderColor="{StaticResource Outline}"
                       BackgroundColor="Transparent" />
            </Border>

            <HorizontalStackLayout Spacing="8" Margin="0,8,0,0">
                <CheckBox x:Name="PrivacyCheck" Color="{StaticResource Primary}" VerticalOptions="Center" />
                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                    <Label Text="我已閱讀"
                           Style="{StaticResource BodyLabel}"
                           VerticalOptions="Center" />
                    <Button Text="隱私權政策"
                            Style="{StaticResource LinkButton}"
                            HorizontalOptions="Start"
                            Padding="0"
                            Clicked="OnPrivacyClicked" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <Button Text="建立帳號"
                    Style="{StaticResource PrimaryButton}"
                    CornerRadius="28"
                    Clicked="OnCreateClicked"
                    Margin="0,12,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
