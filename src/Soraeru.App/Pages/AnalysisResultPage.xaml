<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Soraeru.Pages.AnalysisResultPage"
             Title="分析結果"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{StaticResource SurfaceBright}">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20,16" Spacing="12" MaximumWidthRequest="480" HorizontalOptions="Center">

                <Label x:Name="SourceTextLabel"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="{StaticResource OnSurface}" />
                <Label x:Name="LanguageLabel"
                       Style="{StaticResource BodyLabel}" />

                <Label x:Name="MeaningLabel" Style="{StaticResource BodyLabel}" FontSize="16" Margin="0,8,0,0" />
                <Label x:Name="ReadingLabel" Style="{StaticResource BodyLabel}" FontSize="16" />

                <Button Text="▶  播放正式發音"
                        Style="{StaticResource SecondaryButton}"
                        Clicked="OnPlayClicked"
                        Margin="0,4,0,8" />

                <Border x:Name="DraftBadgeBanner" Style="{StaticResource WarningBanner}" IsVisible="False">
                    <Label x:Name="DraftBadgeLabel"
                           Text="AI 草稿／未經聽感核定"
                           TextColor="{StaticResource StatusWarning}"
                           FontAttributes="Bold"
                           FontSize="14" />
                </Border>

                <Border x:Name="VerifiedBadgeBanner" Style="{StaticResource InfoBanner}" IsVisible="False">
                    <Label x:Name="VerifiedBadgeLabel"
                           Text="聽感已核定／策展"
                           TextColor="{StaticResource StatusInfo}"
                           FontAttributes="Bold"
                           FontSize="14" />
                </Border>

                <Border Style="{StaticResource WarningBanner}">
                    <Label x:Name="NoticeLabel"
                           Text="⚠ 以下近似音僅供記憶，請以正式發音為準"
                           TextColor="{StaticResource StatusWarning}"
                           FontAttributes="Bold"
                           FontSize="14" />
                </Border>

                <VerticalStackLayout x:Name="MnemonicsHost" Spacing="8" />

                <Label x:Name="QuotaLabel"
                       Style="{StaticResource CaptionLabel}"
                       Margin="0,4,0,0" />

                <Button Text="語言不對？返回修改"
                        Style="{StaticResource LinkButton}"
                        HorizontalOptions="Start"
                        Clicked="OnFixLanguageClicked" />
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1"
              Style="{StaticResource StickyBar}"
              ColumnDefinitions="*,*"
              ColumnSpacing="12">
            <Button Grid.Column="0"
                    Text="重新產生"
                    Style="{StaticResource SecondaryButton}"
                    Clicked="OnRegenerateClicked" />
            <Button Grid.Column="1"
                    Text="儲存單字卡"
                    Style="{StaticResource PrimaryButton}"
                    Clicked="OnSaveClicked" />
        </Grid>
    </Grid>
</ContentPage>
